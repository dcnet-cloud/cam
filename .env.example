# ACS portal prod env (copy → .env, điền giá trị thật, KHÔNG commit .env)
JWT_SECRET=changeme_random_32bytes
# go2rtc: backend dùng service name; browser dùng Caddy /live (set go2rtc_url ở /settings)
GO2RTC_INTERNAL_URL=http://go2rtc-acs:1984
# Camera khách (điền khi hứng thiết bị)
CAM_USER=changeme
CAM_PASS=changeme
